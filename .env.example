# CodeQuest environment variables — names and placeholders only. Copy to .env.local.
# Never put a server secret in a NEXT_PUBLIC_* variable.

# --- Java execution (Vercel Sandbox) ---------------------------------------------------------
# Snapshot built by `npm run runner:prepare` (see runner/snapshot-manifest.json).
JAVA_SNAPSHOT_ID=snap_placeholder

# Sandbox auth, option A (recommended): `vercel link` then `vercel env pull .env.local` writes
# VERCEL_OIDC_TOKEN here. It expires after ~12h locally; re-run `vercel env pull`. On Vercel it is
# managed automatically.
# VERCEL_OIDC_TOKEN=

# Sandbox auth, option B: personal access token scoped to the team (all three together).
# VERCEL_TOKEN=
# VERCEL_TEAM_ID=
# VERCEL_PROJECT_ID=

# Snapshot preparation (optional overrides)
# SNAPSHOT_EXPIRATION_DAYS=30
# PREPARE_TIMEOUT_MINUTES=15

# Execution limits (optional overrides; defaults are spec §65 initial values)
# EXECUTION_MAX_SOURCE_FILES=20
# EXECUTION_MAX_TOTAL_SOURCE_BYTES=204800
# EXECUTION_COMPILE_WALL_SECONDS=30
# EXECUTION_TEST_WALL_SECONDS=10
# EXECUTION_HEAP_MB=256
# EXECUTION_MAX_OUTPUT_BYTES=65536
# EXECUTION_MAX_REPORT_BYTES=1048576
# EXECUTION_SANDBOX_LIFETIME_SECONDS=60
# EXECUTION_COMMAND_GRACE_SECONDS=5
# EXECUTION_CLEANUP_TIMEOUT_SECONDS=15
# EXECUTION_VCPUS=1

# --- Supabase (Phase 0 step 2; not used by code yet) -----------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder
# SUPABASE_SECRET_KEY=   # server-only; never NEXT_PUBLIC

# --- App ---------------------------------------------------------------------------------------
# APP_ORIGIN=http://localhost:3000
