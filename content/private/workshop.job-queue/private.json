      {
        "id": "stable-heap",
        "criterion": "explanation",
        "skill": "ds.heaps",
        "prompt": "How do you make a binary heap return equal priorities in submission order?",
        "options": [
          "Store a sequence number with each job and break priority ties by it",
          "Use a bigger heap",
          "Sort the heap after every insert",
          "Heaps are always stable"
        ],
        "answer": 0,
        "why": "Heaps don't preserve insertion order. Adding an increasing sequence number as a tie-breaker makes the ordering total and fair. (Comparing with priority subtraction could overflow; compare with Integer.compare or comparingInt.)"
      }
    ]
  }
