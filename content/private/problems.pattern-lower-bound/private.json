  "hints": [
    {
      "tier": "direction",
      "text": "The condition sorted[i] >= target is false, false, …, then true, true: find where it flips."
    },
    {
      "tier": "pattern",
      "text": "Binary search on that boundary with a half-open range [lo, hi), starting hi at sorted.length."
    },
    {
      "tier": "key_insight",
      "text": "If sorted[mid] >= target, mid could be the answer: hi = mid. Otherwise lo = mid + 1. Stop when lo == hi and return lo."
    }
