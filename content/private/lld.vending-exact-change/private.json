    "followUps": [
      {
        "id": "greedy-fails",
        "criterion": "explanation",
        "skill": "lld.extensibility",
        "prompt": "Why can 'always give the largest coin that fits' fail when the machine's coins are limited?",
        "options": [
          "Taking a large coin early can leave a remainder the remaining coins can't make, while another combination works",
          "Large coins are worth less",
          "Greedy is always optimal for coins",
          "Because Java integers overflow"
        ],
        "answer": 0,
        "why": "With limited supply the greedy choice isn't safe: e.g. 30¢ from {25, 10, 10, 10} fails greedily (25 then 5 missing) but three dimes work. Search the combinations instead."
      }
    ]
  }
