  "hints": [
    {
      "tier": "direction",
      "text": "You only ever need to remember the k largest values seen so far."
    },
    {
      "tier": "pattern",
      "text": "A min-heap of size k: its smallest element is the one to evict when a bigger value arrives."
    },
    {
      "tier": "key_insight",
      "text": "Offer every value; whenever the heap holds more than k, poll. At the end, poll k times and fill the result from the back."
    }
  ],
  "referenceDir": "reference",
  "rubric": {
    "edgeCases": [
      "k-zero",
      "k-all",
      "k-too-big",
      "k-negative",
      "null-values",
      "empty-k-zero",
      "duplicates-count"
    ],
    "followUps": [
      {
        "id": "topk-time",
        "criterion": "time_complexity",
        "skill": "ds.heaps",
        "prompt": "What is the time complexity of the size-k min-heap approach for n values?",
        "options": [
          "O(n log k)",
          "O(n log n)",
          "O(n k)",
          "O(k)"
        ],
        "answer": 0,
        "why": "Each value costs at most an offer and a poll on a heap of at most k + 1 elements."
      },
      {
        "id": "topk-space",
        "criterion": "space_complexity",
        "skill": "ds.heaps",
        "prompt": "How much extra memory does it use, apart from the result?",
        "options": [
          "O(k): the heap never holds more than k + 1 values",
          "O(n)",
          "O(1)",
          "O(n log k)"
        ],
        "answer": 0,
        "why": "Only the current top k (plus the one being compared) are kept, however long the input is."
      }
    ]
  }
