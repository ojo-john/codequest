  "hints": [
    {
      "tier": "direction",
      "text": "Put each check at the boundary where bad data would enter: the constructor of Product and CartItem, and the start of each ShoppingCart method."
    },
    {
      "tier": "pattern",
      "text": "Validate first, change state last. If every check runs before you touch the map, a rejected call can't leave the cart half-changed."
    },
    {
      "tier": "key_insight",
      "text": "items() can return a copy that can't be modified. The JDK already has one: List.copyOf(...) gives an unmodifiable snapshot."
    },
    {
      "tier": "pseudocode",
      "text": "Product: if text is null or isBlank() -> throw; if price < 0 -> throw. changeQuantity: existing = map.get(sku); if null -> throw; if qty < 0 -> throw; if qty == 0 -> map.remove(sku) else map.put(sku, new CartItem(existing.product(), qty))."
    }
  ],
  "referenceDir": "reference",
  "rubric": {
    "edgeCases": [
      "product-allows-free-item",
