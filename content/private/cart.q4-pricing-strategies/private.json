  "hints": [
    {
      "tier": "direction",
      "text": "Copy the shape of RegularPricing: implement totalCents, ask the cart for its subtotal, then apply your rule."
    },
    {
      "tier": "pattern",
      "text": "Validate the percent in the constructor so a PercentOffPricing object can never exist with an invalid percent."
    },
    {
      "tier": "key_insight",
      "text": "Shipping is decided by the amount the customer actually pays, so call Checkout.shippingCents on the discounted amount, not the original subtotal."
    },
    {
      "tier": "pseudocode",
      "text": "discount = multiplyExact(subtotal, percent) / 100; discounted = subtotal - discount; return discounted + shippingCents(discounted). Cart: if pricing == null -> throw; return pricing.totalCents(this)."
    }
  ],
  "referenceDir": "reference"
