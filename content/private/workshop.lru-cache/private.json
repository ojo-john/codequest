    "followUps": [
      {
        "id": "why-linked-list",
        "criterion": "explanation",
        "skill": "practical.caching",
        "prompt": "Why does an O(1) LRU cache pair a hash map with a doubly linked list?",
        "options": [
          "The map finds a node in O(1); the list moves it to the front or drops the oldest in O(1)",
          "The list keeps keys sorted alphabetically",
          "The map alone is O(1) for everything, the list is just for printing",
          "A singly linked list would be just as fast for removing an arbitrary node"
        ],
        "answer": 0,
        "why": "Removing an arbitrary node in O(1) needs its previous pointer, so the list is doubly linked; the map gives O(1) access to that node."
      }
    ]
  }
