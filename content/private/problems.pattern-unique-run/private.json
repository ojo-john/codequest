  "hints": [
    {
      "tier": "direction",
      "text": "It's about a contiguous region with a rule you can keep true while it grows: no repeats."
    },
    {
      "tier": "pattern",
      "text": "Sliding window: extend the right end each step; when a repeat enters, move the left end past the earlier copy."
    },
    {
      "tier": "key_insight",
      "text": "Remember each character's last position. Only jump left forward (never back): \"abba\" is the trap."
    }
  ],
