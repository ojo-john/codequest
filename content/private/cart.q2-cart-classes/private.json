  "hints": [
    {
      "tier": "direction",
      "text": "Start with CartItem.lineTotalCents \u2014 it's one line that calls a method you already have."
    },
    {
      "tier": "pattern",
      "text": "For add(): look the SKU up in the map first. Absent means a new line; present means a replacement line with the summed quantity."
    },
    {
      "tier": "key_insight",
      "text": "Because CartItem is immutable you never change a line in place \u2014 you put a new CartItem under the same SKU key, which also keeps the line in its original position in a LinkedHashMap."
    },
    {
      "tier": "pseudocode",
      "text": "add: existing = map.get(sku); qty = existing == null ? quantity : existing.quantity() + quantity; map.put(sku, new CartItem(product, qty)). subtotal: loop over map.values() adding lineTotalCents(). items: new ArrayList<>(map.values())."
    }
  ],
