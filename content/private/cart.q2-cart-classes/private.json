    "followUps": [
      {
        "id": "why-linked-hash-map",
        "criterion": "explanation",
        "skill": "java.collections",
        "prompt": "Why does ShoppingCart keep its lines in a LinkedHashMap keyed by SKU rather than in a List?",
        "options": [
          "A map always uses less memory than a list.",
          "A SKU can be found (and merged) by a direct key lookup, and LinkedHashMap still remembers the order lines were first added.",
          "A List can't hold CartItem objects.",
          "HashMap sorts SKUs alphabetically, which the cart needs."
        ],
        "answer": 1,
        "why": "Keying by SKU makes 'is this product already in the cart?' a single lookup, so adding the same product merges lines. A plain HashMap would lose the insertion order that items() promises; LinkedHashMap keeps it."
      },
      {
        "id": "quantity-of-time",
        "criterion": "time_complexity",
        "skill": "java.collections",
        "prompt": "What is the typical cost of quantityOf(sku) when lines are stored in the map?",
        "options": [
          "O(1) on average: one hash lookup.",
          "O(n): it scans every line.",
          "O(log n): it binary-searches the SKUs.",
          "O(n log n): it sorts first."
        ],
        "answer": 0,
        "why": "A hash map finds a key in constant time on average, however many lines the cart has. Scanning a List would be O(n)."
      },
      {
        "id": "why-reuse-checkout",
        "criterion": "explanation",
        "skill": "java.classes",
        "prompt": "Why does CartItem.lineTotalCents call Checkout.lineTotalCents instead of multiplying price × quantity itself?",
        "options": [
          "CartItem can't multiply numbers.",
          "So one tested implementation, including its validation and overflow check, is the single place the rule lives.",
          "Java requires static methods to be reused.",
          "It makes the calculation faster."
        ],
        "answer": 1,
        "why": "Duplicated rules drift apart. Reusing the method means a fix or a new check (like overflow detection) applies everywhere at once."
      }
    ]
  }
