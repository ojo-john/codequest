  "hints": [
    {
      "tier": "direction",
      "text": "Handle the cases in order: null, then splitting on the comma, then the SKU, then the quantity."
    },
    {
      "tier": "pattern",
      "text": "Validate each part with a precise rule (a regular expression works well) before converting it, so conversion can't fail in a surprising way."
    },
    {
      "tier": "key_insight",
      "text": "split(\",\") drops trailing empty strings, so \"TEA-1,\" would look like one part. split(\",\", -1) keeps them; then require exactly two parts."
    },
    {
      "tier": "pseudocode",
      "text": "if line == null -> throw; parts = line.split(\",\", -1); if parts.length != 2 -> throw; sku = parts[0].trim().toUpperCase(); if !sku.matches(\"[A-Z0-9-]{1,20}\") -> throw; q = parts[1].trim(); if !q.matches(\"[0-9]{1,9}\") -> throw; n = parseInt(q); if n < 1 || n > 99 -> throw; return new OrderLine(sku, n)."
    }
  ],
