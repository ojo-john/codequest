  "hints": [
    {
      "tier": "direction",
      "text": "size is both the number of items and the index where the next push goes."
    },
    {
      "tier": "pattern",
      "text": "peek and pop share the empty check; pop can call peek and then shrink size."
    },
    {
      "tier": "key_insight",
      "text": "When size equals items.length, copy into an array twice as big (Arrays.copyOf does this) before storing."
    }
  ],
  "referenceDir": "reference",
