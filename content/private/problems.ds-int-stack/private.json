    ],
    "followUps": [
      {
        "id": "why-double",
        "criterion": "time_complexity",
        "skill": "ds.stacks-queues",
        "prompt": "Why does the array double when it's full instead of growing by one slot?",
        "options": [
          "Doubling makes copying rare, so push stays O(1) amortized; growing by one would copy every time, making n pushes O(n²)",
          "Doubling uses less memory",
          "Java arrays can only double",
          "Growing by one doesn't compile"
        ],
        "answer": 0,
        "why": "Copies happen at sizes 4, 8, 16, …; their total is under 2n, so each push costs O(1) on average. Growing by one copies the whole array on every push."
      },
      {
        "id": "why-throw",
        "criterion": "explanation",
        "skill": "ds.stacks-queues",
        "prompt": "Why throw an exception from pop() on an empty stack instead of returning 0?",
        "options": [
          "0 could be a real value on the stack, so returning it would hide the bug from the caller",
          "Exceptions are faster than return values",
          "Java requires methods to throw on empty collections",
          "Returning 0 doesn't compile"
        ],
        "answer": 0,
        "why": "A sentinel only works if it can't be a real value. For an int stack any int is valid, so failing loudly is the honest contract."
      }
    ]
  }
