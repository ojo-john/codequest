    "followUps": [
      {
        "id": "why-no-changes-needed",
        "criterion": "explanation",
        "skill": "java.interfaces",
        "prompt": "Why could BulkDiscountPricing be added without changing ShoppingCart or PriceComparison?",
        "options": [
          "Both depend only on the PricingStrategy interface, so any new implementation plugs in.",
          "Java recompiles every class automatically.",
          "BulkDiscountPricing extends ShoppingCart.",
          "PriceComparison uses instanceof to find new strategies."
        ],
        "answer": 0,
        "why": "Open for extension, closed for modification: code written against an abstraction accepts new implementations without edits."
      },
      {
        "id": "bulk-time",
        "criterion": "time_complexity",
        "skill": "java.loops",
        "prompt": "How does BulkDiscountPricing's work grow with the number of lines n?",
        "options": [
          "O(n): one pass, applying the rule to each line.",
          "O(n²): each line is compared with all others.",
          "O(1): it only looks at the subtotal.",
          "O(n log n): it sorts the lines first."
        ],
        "answer": 0,
        "why": "Each line is checked against the minimum quantity and priced once; nothing needs sorting or pairwise comparison."
      }
    ]
  }
