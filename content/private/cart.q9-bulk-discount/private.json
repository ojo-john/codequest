  "hints": [
    {
      "tier": "direction",
      "text": "You only need one new class. Loop over cart.items() and work out each line's price."
    },
    {
      "tier": "pattern",
      "text": "Accumulate a discounted subtotal line by line, then add shipping once at the end on that discounted amount."
    },
    {
      "tier": "key_insight",
      "text": "The discount is per line, rounded down per line: lineTotal - multiplyExact(lineTotal, 10) / 100 — not 10% of the whole subtotal."
    },
    {
      "tier": "pseudocode",
      "text": "sum = 0; for item in cart.items(): line = item.lineTotalCents(); if item.quantity() >= 3: line -= multiplyExact(line, 10) / 100; sum = addExact(sum, line). return sum + cart.shippingCentsFor(sum)."
    }
  ],
