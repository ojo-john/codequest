  "hints": [
    {
      "tier": "direction",
      "text": "The report says the order changes after top3() runs. Which line in top3 changes state rather than just reading it?"
    },
    {
      "tier": "pattern",
      "text": "Arrays.sort sorts the array you give it in place. Sorting a field is a side effect every later caller sees."
    }
  ],
  "referenceDir": "reference",
  "rubric": {
    "edgeCases": [
      "order-kept-after-top3",
      "fewer-than-three",
      "empty"
    ],
    "followUps": [
      {
        "id": "diagnosis",
        "criterion": "explanation",
        "skill": "debug.diagnosis",
        "prompt": "What was the root cause?",
        "options": [
          "top3() sorted the leaderboard's own array in place, a side effect that changed every later read",
          "scores() returned the wrong array",
          "The constructor forgot to copy the input",
          "Arrays.sort is unstable"
        ],
        "answer": 0,
        "why": "A query method mutated state. Sorting a copy keeps top3() free of side effects."
      },
      {
        "id": "prevention",
        "criterion": "explanation",
        "skill": "debug.diagnosis",
        "prompt": "What test shape catches hidden side effects like this?",
        "options": [
          "Call the method, then check the object's other observable state is unchanged",
          "Call the method once and check only its return value",
          "Only test with already sorted input",
          "Test that no exception is thrown"
        ],
        "answer": 0,
        "why": "Checking return values alone can't see side effects. Assert the state after the call, too (and test sorted input last, since it hides this bug)."
      }
    ]
  },
  "testQuality": {
    "target": "src/main/java/problems/Leaderboard.java",
