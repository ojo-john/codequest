  "hints": [
    {
      "tier": "direction",
      "text": "For each value x you need to know whether target − x appeared earlier."
    },
    {
      "tier": "pattern",
      "text": "A HashMap from value to the first position it appeared at answers that in O(1)."
    },
    {
      "tier": "key_insight",
      "text": "Look up target − x before storing x, so x can't pair with itself; use putIfAbsent to keep the earliest position."
    }
  ],
