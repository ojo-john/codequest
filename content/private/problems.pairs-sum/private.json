        "criterion": "explanation",
        "skill": "patterns.hashing",
        "prompt": "Sorting plus two pointers also finds a pair. Why is it a worse fit here?",
        "options": [
          "Sorting loses the original positions (unless you carry them along) and costs O(n log n)",
          "Two pointers don't work on numbers",
          "Sorting uses no memory",
          "It finds pairs that don't add up"
        ],
        "answer": 0,
