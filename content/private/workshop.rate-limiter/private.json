    "followUps": [
      {
        "id": "bucket-vs-window",
        "criterion": "explanation",
        "skill": "practical.rate-limiting",
        "prompt": "What does a token bucket allow that a fixed one-minute window counter doesn't handle well?",
        "options": [
          "Controlled bursts up to the capacity while holding the long-run rate, without a burst of double traffic at window edges",
          "Unlimited requests",
          "Exactly one request per second, never more",
          "Rate limiting across many servers with no shared state"
        ],
        "answer": 0,
        "why": "Fixed windows let a client send a full quota at the end of one window and again at the start of the next. A bucket smooths that while still allowing bounded bursts. Distributed limiting still needs shared state."
      }
    ]
  }
