        "skill": "lld.object-modeling",
        "prompt": "Why should a refused sale (sold out, not enough money) leave the balance untouched?",
        "options": [
          "A failed operation shouldn't change state halfway: the customer can add money, pick another item or cancel",
          "Refunds are handled by the bank",
          "It's faster",
          "The balance is always zero after any select"
        ],
        "answer": 0,
        "why": "Validate everything first, then change state. A half-applied failure loses money or stock."
