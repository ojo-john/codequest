    "followUps": [
      {
        "id": "inject-time",
        "criterion": "explanation",
        "skill": "practical.caching",
        "prompt": "Why pass the current time in (or inject a clock) instead of calling System.currentTimeMillis() inside the cache?",
        "options": [
          "Tests can check expiry at exact instants without sleeping, so they are fast and not flaky",
          "It makes the cache thread-safe",
          "System.currentTimeMillis() is deprecated",
          "It uses less memory"
        ],
        "answer": 0,
        "why": "Time is an external dependency. Controlling it in tests makes boundary behaviour checkable and removes sleep-based flakiness."
      }
